---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { socialLinks } from "../data/social";
---

<Layout
    title="Contact Us - St Catherine's Group"
    description="Get in touch with St Catherine's Group. We're here to answer your questions and discuss how we can support you."
>
    <Navbar />

    <main>
        <section class="py-18 bg-white">
            <div class="max-w-4xl md:max-w-5xl mx-auto px-6 text-center">
                <h2
                    class="inline-flex items-center gap-2 px-4 py-2 mb-6 bg-green-primary text-white font-semibold text-2xl md:text-3xl rounded-lg group shadow-lg"
                >
                    Get In Touch
                </h2>

                <h1 class="text-5xl md:text-8xl font-bold text-green-dark mb-8">
                    Let's talk
                </h1>
                <p
                    class="text-green-dark text-2xl md:text-3xl leading-relaxed mb-12 max-w-3xl mx-auto"
                >
                    We're here to listen, answer your questions, and discuss how
                    we can best support you or your loved ones.
                </p>

                <div
                    class="flex flex-col sm:flex-row gap-6 justify-center flex-wrap"
                >
                    <a
                        href="tel:+442080874717"
                        class="flex w-full sm:w-auto items-center justify-center gap-3 px-8 py-4 bg-green-primary text-white font-medium text-3xl rounded-lg hover:bg-green-primary/90 transition-all duration-200 shadow-md"
                    >
                        <svg
                            class="w-6 h-6 shrink-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                            ></path>
                        </svg>
                        020 8087 4717
                    </a>
                    <a
                        href="tel:+447780149826"
                        class="flex w-full sm:w-auto items-center justify-center gap-3 px-8 py-4 border-2 border-green-primary text-green-primary font-medium text-3xl rounded-lg hover:bg-green-primary hover:text-white transition-all duration-200"
                    >
                        <svg
                            class="w-6 h-6 shrink-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                            ></path>
                        </svg>
                        07780 149826
                    </a>
                    <a
                        href="mailto:clientservices@stcatherinesgroup.com"
                        class="flex w-full sm:w-auto items-center justify-center gap-3 px-8 py-4 border-2 border-green-primary text-green-primary font-medium text-3xl rounded-lg hover:bg-green-primary hover:text-white transition-all duration-200"
                    >
                        <svg
                            class="w-6 h-6 shrink-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                            ></path>
                        </svg>
                        Email
                    </a>
                </div>

                <div class="mt-14">
                    <p class="text-green-dark text-2xl md:text-3xl mb-6">
                        Follow us
                    </p>
                    <ul class="flex justify-center gap-5">
                        {socialLinks.map((social) => (
                            <li>
                                <a
                                    href={social.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={`St Catherine's Group on ${social.name} (opens in a new tab)`}
                                    class="block w-16 h-16 p-1 rounded-xl transition-transform duration-200 hover:scale-110 focus-visible:scale-110 drop-shadow-md [&>svg]:w-full [&>svg]:h-full"
                                    set:html={social.logo}
                                />
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
