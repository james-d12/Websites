---
import { Image } from "astro:assets";
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CallToAction from "../components/CallToAction.astro";
import ProseContent from "../components/ProseContent.astro";
import PullQuote from "../components/PullQuote.astro";
import SectionDivider from "../components/SectionDivider.astro";
import favicon from "../assets/favicon.ico";

const entry = await getEntry("pages", "about");
const { Content } = await render(entry);
const { title, description, hero } = entry.data;
---

<Layout title={title} description={description}>
    <Navbar />
    <main>
        <section class="relative bg-white pt-10 pb-10">
            <div class="flex justify-center mb-12">
                <div class="bg-linear-to-l from-green-dark via-green-dark to-green-darker rounded-2xl shadow-lg">
                    <Image
                        src={favicon}
                        alt="St Catherine's Group Logo"
                        width={128}
                        height={128}
                        class="w-38 h-38"
                    />
                </div>
            </div>

            <div class="max-w-4xl md:max-w-5xl mx-auto text-center">
                <h1 class="text-green-dark text-3xl md:text-7xl mb-6">
                    {hero.heading}
                </h1>
            </div>
        </section>

        <section class="bg-white pb-10">
            <div class="relative mx-auto max-w-5xl md:max-w-6xl px-4 md:px-20">
                <div class="hidden md:block absolute inset-y-0 left-0 w-1.5 bg-green-dark" aria-hidden="true"></div>
                <div class="hidden md:block absolute inset-y-0 right-0 w-1.5 bg-green-dark" aria-hidden="true"></div>
                <ProseContent>
                    <Content />
                </ProseContent>
            </div>
        </section>
    </main>

    <SectionDivider />

    <CallToAction />
    <Footer />
</Layout>
