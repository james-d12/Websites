---
import '../styles/global.css'
import PageFrame from '../components/PageFrame.astro'

export interface Props {
  title?: string;
  description?: string;
  /** Site-relative path to the social share image. Defaults to the favicon. */
  image?: string;
  /** Ask search engines not to index this page (e.g. link-only pages). */
  noindex?: boolean;
  /** Show the gradient side frame. Off for standalone pages without navbar/footer. */
  frame?: boolean;
}

const {
  title = "St Catherine's Group",
  description = "St Catherine's Group provides exceptional 1-1 care and professional nursing services, with dedicated carers and registered nurses delivering personalised, compassionate healthcare for you and your loved ones.",
  image,
  noindex = false,
  frame = true,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const logoUrl = new URL('/favicon.ico', Astro.site);
const shareImage = image ? new URL(image, Astro.site) : logoUrl;

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "St Catherine's Group",
	url: "https://stcatherinesgroup.com",
	logo: logoUrl.toString(),
	telephone: "+442036633074",
	email: "clientservices@stcatherinesgroup.com",
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<title>{title}</title>
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml"/>
		<link rel="canonical" href="https://stcatherinesgroup.com/">
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={shareImage} />
		<meta property="og:site_name" content="St Catherine's Group" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImage} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Lora:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
	</head>
	<body class="bg-brand-gradient antialiased">
		<slot />
		{frame && <PageFrame />}
	</body>
</html>
